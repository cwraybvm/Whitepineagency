generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique @default("default-org")
  domain            String?
  primaryKeyword    String? // Target search phrase tracked for local rank/competitor snapshots
  status            String   @default("ACTIVE") // ACTIVE, SUSPENDED, CANCELED

  // Whitelabel Branding — applied to the client's own portal view
  logoUrl          String?
  primaryColor     String? // hex, e.g. "#2563EB"
  accentColor      String? // hex, e.g. "#F59E0B" — second brand color, alongside primaryColor
  customDomain     String?
  disabledFeatures String[] @default([]) // FeatureKey values (src/config/tenantFeatures.ts) this tenant has turned off

  // Brand DNA — persona/voice notes injected into Creative Sandbox generation
  // prompts. Null on most orgs today; generate falls back to a default tone.
  brandVoice      String?
  brandGuidelines String? @db.Text

  // Outbound Webhook Engine — client-registered listener (Zapier/Make.com etc.)
  // that receives lead.created / task.sla_breached / intake.completed events.
  webhookUrl String? @db.Text

  // Number provisioned via the Fulfillment "Provision Phone Number" action
  twilioPhoneNumber String?

  // Multi-Tenant Agency & Integration Keys
  mailchimpApiKey   String?  @db.Text
  mailchimpListId   String?
  wordpressUrl      String?
  wordpressUsername String?
  wordpressAppPass  String?  @db.Text

  // Social API Tokens
  metaPageAccessToken String? @db.Text
  metaPageId          String?
  linkedInAccessToken String? @db.Text
  linkedInAuthorUrn   String?

  // Stripe Billing Customer Reference
  stripeCustomerId     String?
  stripeSubscriptionId String?

  // Hourly rate applied to this client's unbilled TimeEntry rows when
  // generating an invoice — falls back to DEFAULT_HOURLY_RATE when unset.
  hourlyRate Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relations
  members            Member[]
  leads              Lead[]
  auditRuns          AuditRun[]
  contentPosts       ContentPost[]
  taskColumns        TaskColumn[]
  taskCards          TaskCard[]
  clientKpis         ClientKpi[]
  taskTemplates      RecurringTaskTemplate[]
  inboxMessages      InboxMessage[]
  monthlyReports     MonthlyReport[]
  seoKeywords        SeoKeyword[]
  subscriptions      Subscription[]
  portalLeads        PortalLead[]
  fulfillmentTasks   FulfillmentTask[]
  creativeAssets     CreativeAsset[]
  clientMeetings     ClientMeeting[]
  expenses           Expense[]
  timeEntries        TimeEntry[]
  tasks              Task[]
  campaigns          Campaign[]
  invoices           Invoice[]

  @@index([customDomain])
}

// RBAC tiers. OWNER/OPERATOR/SALES are internal White Pine staff roles —
// CLIENT_OWNER/CLIENT_MEMBER are the pre-existing client-side roles, kept
// as-is; this enum doesn't change what a client can access, only adds real
// enforcement for the staff tiers. See src/proxy.ts for the route matrix.
enum UserRole {
  OWNER
  OPERATOR
  SALES
  CLIENT_OWNER
  CLIENT_MEMBER
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  fullName     String?
  passwordHash String    @default("")
  role         UserRole  @default(SALES)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  members Member[]
}

model Member {
  id             String @id @default(uuid())
  role           String @default("MEMBER") // OWNER, MEMBER, VIEWER
  organizationId String
  userId         String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Lead {
  id               String   @id @default(uuid())
  businessName     String   @default("Unknown Company")
  url              String   @default("")
  email            String   @default("N/A")
  phone            String   @default("N/A")
  overallScore     Int      @default(50)
  estimatedLoss    Int      @default(2500)
  industry         String   @default("Home Services")
  stage            String   @default("New Lead")
  aiPriority       String   @default("Stable")
  memo             String?  @db.Text
  aiOutreachScript String   @default("") @db.Text
  organizationId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     LeadMessage[]

  @@index([organizationId])
  @@index([stage])
}

// 💬 Two-way SMS thread for a CRM Lead (Twilio), shown in the CRM chat drawer
model LeadMessage {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction  String // inbound (from the lead) | outbound (from us)
  body       String   @db.Text
  fromNumber String?
  toNumber   String?
  twilioSid  String?
  createdAt  DateTime @default(now())

  @@index([leadId])
}

model ContentPost {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title            String
  status           String       @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, SCHEDULED, PUBLISHED, FAILED
  approvalNotes    String?      @db.Text

  // Content & Social Copy
  content          String?      @db.Text
  blogMarkdown     String?      @db.Text
  emailDraft       String?      @db.Text
  instagramCaption String?      @db.Text
  twitterThread    String?      @db.Text
  linkedinPost     String?      @db.Text
  reelScript       String?      @db.Text
  imagePrompt      String?      @db.Text

  // Calendar & Media Extensions
  scheduledAt      DateTime?
  publishedAt      DateTime?
  platforms        String[]     @default([])
  mediaUrl         String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
  @@index([scheduledAt])
  @@index([status])
}

// AI Creative Sandbox: generated copy/ad/video-script/landing-page assets,
// staged unassigned until "Promote to Production" attaches them to an Organization
model CreativeAsset {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title    String
  type     String @default("COPY") // COPY, AD, VIDEO_SCRIPT, LANDING_PAGE
  status   String @default("DRAFT") // DRAFT, STAGED, PRODUCTION
  content  String @db.Text
  metadata Json?
  version  Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([type])
}

model TaskColumn {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  orderPosition  Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cards          TaskCard[]

  @@index([organizationId])
}

model TaskCard {
  id             String   @id @default(uuid())
  organizationId String
  columnId       String
  title          String
  description    String?  @db.Text
  assignee       String?
  dueDate        String?
  tagLabel       String?  @default("General")
  tagColor       String?  @default("bg-white/10 text-gray-300 border-white/15")
  orderPosition  Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  column         TaskColumn   @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([columnId])
}

model ClientKpi {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  metricName     String       // e.g. "Monthly Lead Target", "Target CAC", "Ad Spend ROI"
  currentValue   Float        @default(0)
  targetValue    Float        @default(100)
  unit           String       @default("") // e.g. "$", "%", "leads"
  period         String       @default("Q3 2026")

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model RecurringTaskTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title          String
  description    String?      @db.Text
  frequency      String       @default("WEEKLY") // WEEKLY, MONTHLY
  dayOffset      Int          @default(1) // Day of week (1-7) or Day of month (1-31)
  tagLabel       String?      @default("Recurring")
  tagColor       String?      @default("bg-purple-500/20 text-purple-300 border-purple-500/30")

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model InboxMessage {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  senderName     String       @default("Anonymous")
  senderContact  String       // Email or Phone number
  channel        String       @default("SMS") // SMS, FORM_LEAD, EMAIL
  body           String       @db.Text
  isRead         Boolean      @default(false)

  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model MonthlyReport {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title          String       // e.g. "July 2026 CMO Performance Summary"
  monthPeriod    String       // e.g. "2026-07"
  loomEmbedUrl   String?      @db.Text
  summaryNotes   String?      @db.Text
  metricsSnapshot Json?       // Stores frozen JSON snapshot of KPIs & post stats

  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// 📈 SEO & Search Rank Tracking
model SeoKeyword {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  keyword        String
  currentRank    Int          @default(0)
  previousRank   Int          @default(0)
  searchVolume   Int          @default(0)
  targetUrl      String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// 💳 Stripe Retainer Billing & Access Status
model Subscription {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stripeCustomerId     String
  stripeSubscriptionId String       @unique
  planName             String       @default("Growth Retainer")
  amount               Float        @default(0)
  status               String       @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED
  currentPeriodEnd     DateTime

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId])
}

// 📞 Client Portal: Inbound Customer Lead Feed (calls, forms, texts)
model PortalLead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerName String
  phone        String
  address      String?

  title       String
  subtitle    String @default("")
  jobCategory String @default("General Service")
  badge       String @default("")
  badgeColor  String @default("bg-slate-800 text-slate-200 border border-white/10")

  source    String  @default("organic_web") // google_maps, google_lsa, organic_web, truck_wrap
  fmsStatus String  @default("not_applicable") // synced, manual_needed, not_applicable
  fmsJobId  String?

  estimatedValue Int       @default(0)
  closedValue    Int?
  status         String    @default("pending") // won, in_progress, lost, pending, spam
  assignedTechId String?
  scheduledAt    DateTime?

  unrepliedMinutes Int     @default(0)
  isVip            Boolean @default(false)
  pastJobCount     Int?
  isDuplicate      Boolean @default(false)
  duplicateCount   Int?
  isSnoozed        Boolean @default(false)
  snoozeUntil      String?
  isPinned         Boolean @default(false)

  dispatchNote String? @db.Text

  aiIssue             String?
  aiLocation          String?
  aiRequestedTime     String?
  aiIssueAudioTime    Int?
  aiLocationAudioTime Int?
  aiTimeAudioTime     Int?

  hasAudio      Boolean @default(false)
  audioDuration String?
  transcript    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  history      PortalLeadEvent[]
  chatMessages PortalChatMessage[]

  @@index([organizationId])
  @@index([status])
}

model PortalLeadEvent {
  id          String     @id @default(uuid())
  leadId      String
  lead        PortalLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  event       String
  statusBadge String     @default("")
  createdAt   DateTime   @default(now())

  @@index([leadId])
}

model PortalChatMessage {
  id        String     @id @default(uuid())
  leadId    String
  lead      PortalLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sender    String     // system, customer, staff
  text      String     @db.Text
  createdAt DateTime   @default(now())

  @@index([leadId])
}

// 📦 Fulfillment Center: client onboarding/production board (src/app/(fulfillment)/fulfillment)
model FulfillmentTask {
  id             String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title          String // deliverable / service being fulfilled, e.g. "AI Receptionist + Review Pass"
  clientName     String
  ownerName      String  @default("N/A")
  trade          String  @default("General Trade") // HVAC, Plumbing, Electrical, General Trade
  status         String  @default("Intake Pending") // Intake Pending, Content Uploaded, Setup Live, Active Retainer
  contractValue  Int     @default(0)
  driveFolderUrl String?
  contactEmail   String  @default("N/A")
  contactPhone   String  @default("N/A")
  offerHeadline  String?
  notes          String? @db.Text
  targetLinkUrl  String? // client's review/landing page URL, checked by the "Validate Live Link" action

  // Timer source of truth: when the task entered its current status, and the
  // computed SLA cutoff from that moment. Recomputed on every status change
  // so the countdown always derives from a real timestamp, never a stored
  // day-count that would go stale.
  stageEnteredAt DateTime  @default(now())
  slaDeadline    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  checklist    FulfillmentChecklistItem[]
  intakeAssets IntakeAsset[]

  @@index([organizationId])
  @@index([status])
}

// 📥 Audit record of a raw client intake submission (files + form fields)
// that produced a FulfillmentTask — kept separate from the task itself so
// the original submission is preserved even as the task's pipeline state
// changes.
model IntakeAsset {
  id             String          @id @default(uuid())
  taskId         String
  task           FulfillmentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  clientName     String
  offerDetails   String?         @db.Text
  driveFolderUrl String?
  fileCount      Int             @default(0)
  status         String          @default("PROCESSING") // PROCESSING, COMPLETE, FAILED — set by the intake-processor worker
  errorMessage   String?         @db.Text
  createdAt      DateTime        @default(now())

  @@index([taskId])
}

model FulfillmentChecklistItem {
  id            String          @id @default(uuid())
  taskId        String
  task          FulfillmentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label         String
  done          Boolean         @default(false)
  orderPosition Int             @default(0)

  @@index([taskId])
}

model AuditRun {
  id             String   @id @default(uuid())
  overallScore   Int
  executedBy     String   @default("SYSTEM")
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metrics      Metric[]

  @@index([organizationId])
}

model Metric {
  id         String  @id @default(uuid())
  nodeKey    String
  dataValue  String
  riskLabel  String
  riskColor  String
  isResolved Boolean @default(false)
  auditRunId String

  auditRun AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  @@index([auditRunId])
}

model ClientMeeting {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title         String
  meetingDate   DateTime
  attendees     String[] @default([])
  bodyMarkdown  String   @db.Text
  billableHours Float    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([organizationId])
  @@index([meetingDate])
}

model Expense {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type       String   @default("EXPENSE") // EXPENSE, MILEAGE
  amount     Float    @default(0)
  miles      Float?
  category   String   @default("General")
  receiptUrl String?
  date       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([organizationId])
  @@index([date])
  @@index([type])
}

model TimeEntry {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  startTime       DateTime  @default(now())
  endTime         DateTime?
  durationSeconds Int       @default(0)
  isBilled        Boolean   @default(false)
  description     String?

  invoiceLine InvoiceLine?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([organizationId])
  @@index([isBilled])
}

// Invoice generated from a client's unbilled TimeEntry rows — see
// /api/admin/invoices/generate. One DRAFT invoice accumulates lines per
// generation run until sent/paid.
model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status      String    @default("DRAFT") // DRAFT, SENT, PAID
  periodStart DateTime?
  periodEnd   DateTime?
  hourlyRate  Float     @default(0)
  totalHours  Float     @default(0)
  totalAmount Float     @default(0)

  lines InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([organizationId])
  @@index([status])
}

// One itemized row per billed TimeEntry.
model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  timeEntryId String    @unique
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id])

  description String
  hours       Float
  rate        Float
  amount      Float

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title        String
  status       String       @default("INBOX") // INBOX, ACTIVE, DONE
  priority     Int          @default(0)
  dueDate      DateTime?
  isFocusToday Boolean      @default(false)
  focusOrder   Int?
  subtasks     Json? // AI micro-chunked steps: [{ id, title, done }]
  energyLevel  EnergyLevel? // Cognitive energy required: LOW/MEDIUM/HIGH, null = untagged
  isParked     Boolean      @default(false) // Swept off the active board via the Park for Later drawer
  estimatedMinutes Int? // Quick-picked: 5, 15, 30, 60, or 120
  completedAt      DateTime? // Set server-side when status transitions to DONE, cleared otherwise

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([organizationId])
  @@index([status])
}

model Campaign {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name   String
  status String @default("DRAFT") // DRAFT, ACTIVE, COMPLETE

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  variants CampaignVariant[]

  @@index([organizationId])
  @@index([status])
}

model CampaignVariant {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  headline    String
  spend       Float @default(0)
  impressions Int   @default(0)
  clicks      Int   @default(0)
  conversions Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([campaignId])
}